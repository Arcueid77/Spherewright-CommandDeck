{
	"name": "spherewright-commanddeck",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"main": "apps/desktop/main.mjs",
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"start": "electron .",
		"build:renderer": "vite build",
		"build:native": "dotnet build native/CommandDeck.NativeHost/CommandDeck.NativeHost.csproj -c Release --nologo -o artifacts/native",
		"build:commands": "dotnet build native/CommandDeck.CommandHost/CommandDeck.CommandHost.csproj -c Release --nologo -o artifacts/commands",
		"publish:commands": "node scripts/publish-command-host.mjs",
		"test:portable-command": "node scripts/portable-command-smoke.mjs",
		"test:portable-pi": "node scripts/portable-pi-smoke.mjs",
		"build": "npm run build:native && npm run build:commands && npm run build:renderer",
		"pi:install": "node scripts/pi-source.mjs install",
		"pi:hydrate": "node scripts/pi-source.mjs hydrate",
		"pi:build": "node scripts/pi-source.mjs build",
		"pi:verify": "node scripts/pi-source.mjs verify",
		"test": "node --test test/*.test.mjs",
		"test:native": "node scripts/native-smoke.mjs",
		"probe:native-hang": "node scripts/native-hang-probe.mjs",
		"probe:native-focus": "node scripts/native-input-hang-probe.mjs",
		"test:native-ui-recovery": "node scripts/native-input-hang-probe.mjs --recover-own-ui",
		"test:desktop": "node scripts/run-desktop-smoke.mjs",
		"test:workbench": "node scripts/run-desktop-smoke.mjs --smoke-workbench",
		"test:vault": "node scripts/run-vault-smoke.mjs",
		"test:bridge": "node scripts/run-desktop-smoke.mjs --smoke-bridge",
		"test:observation": "node scripts/run-desktop-smoke.mjs --smoke-observation --observe-only --observe-max-tools 12 --observe-max-ms 10000",
		"test:game": "node scripts/run-desktop-smoke.mjs --smoke-game",
		"test:ui-watchdog": "node scripts/ui-watchdog-native.mjs",
		"test:desktop-host-exit": "node scripts/run-desktop-smoke.mjs --smoke-host-exit",
		"test:desktop-recovery-limit": "node scripts/run-desktop-smoke.mjs --smoke-recovery-limit",
		"test:adapter-native": "node scripts/adapter-native-smoke.mjs",
		"test:adapter-bridge": "node scripts/adapter-bridge-smoke.mjs",
		"test:adapter-layout": "node scripts/adapter-layout-smoke.mjs",
		"test:adapter-route": "node scripts/adapter-route-smoke.mjs",
		"test:desktop-adapter": "node scripts/run-desktop-smoke.mjs --smoke-adapter",
		"build:unity-adapter": "dotnet build native/CommandDeck.UnityAdapter/CommandDeck.UnityAdapter.csproj -c Release --nologo -o artifacts/unity-adapter",
		"smoke:offline": "node apps/desktop/runtime.mjs --offline",
		"smoke:live": "node apps/desktop/runtime.mjs --live",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"dockview-react": "8.6.0",
		"react": "19.3.1",
		"react-dom": "19.3.1"
	},
	"devDependencies": {
		"electron": "44.9.0",
		"vite": "8.3.4",
		"typescript": "7.0.2",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0"
	}
}
