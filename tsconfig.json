{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noEmit": true,
		"lib": ["ES2022", "DOM"],
		"types": ["vite/client"],
		"skipLibCheck": true
	},
	"include": ["apps/renderer/**/*.ts", "apps/renderer/**/*.tsx"]
}
